# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/experience/output/
/experience/timeline-qa/output/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite (development DB)
/tasks.db
/tasks.db-journal
/tasks.db-shm
/tasks.db-wal
/notes.db
/notes.db-journal
/notes.db-shm
/notes.db-wal

# clerk configuration (can include secrets)
/.clerk/

# user-uploaded attachments (out-of-tree storage; not served from /public)
/.data/

roadmap.db

# local module dev DBs (migration)
analytics.db*
roadmap.db*
prefs.db*
.db-evidence/

# database backups taken by scripts/db/backup.mjs — never committed
.db-backups/

# scratch capture/probe scripts written beside the repo while measuring a
# surface. They belong in the session scratchpad; three of them reached a
# commit before this rule existed.
*.tmp.mjs

# probe files written by panel agents driving the lab
.panel-tmp/
_shots/
_probe*.mjs
_drive*.mjs
t[0-9].mjs
.probe/
probe-tmp.mjs
_*.mjs
chk.mjs
.seat-tmp/
_seat/
drive_tmp.mjs
# round 8: a seat left m-probe.mjs and a fix script left _fixre.py, neither
# of which any existing pattern caught.
*-probe.mjs
_seat*/
_typo/
_ref_*.png
_r9block.js
.tmp-verify/
_m9_*.png
_*.cjs
_*.py
_*.cjs
peelcheck*.mjs
_rf_*.png
_rf_*.mjs
sc_*.mjs
sc_*.png
m_tmp.mjs

# seat scratch, any depth
**/_m9/
**/_seat*/
**/_probe*/

# Seat and probe scratch. Every round since round 1 has leaked a
# different name for the same thing (_m9_, _ux10_, _typo/, _ref_read.png,
# _seat9/), and each one cost a commit to clean up. Scoped to the two
# places seats actually write, NOT repo-wide: src/modules/signal/lib/
# triggers/_helpers.ts and drizzle*/meta/_journal.json are real source
# and a blanket rule would have hidden them.
/_*
!/_wt-*
docs/design/labs/notes-2026-08/_*
scripts/design/_*
