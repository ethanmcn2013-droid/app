# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/experience/output/
/experience/timeline-qa/output/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# claude code — per-machine permission grants, never shared
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite (development DB)
/tasks.db
/tasks.db-journal
/tasks.db-shm
/tasks.db-wal
/notes.db
/notes.db-journal
/notes.db-shm
/notes.db-wal

# clerk configuration (can include secrets)
/.clerk/

# user-uploaded attachments (out-of-tree storage; not served from /public)
/.data/

roadmap.db

# local module dev DBs (migration)
analytics.db*
roadmap.db*
prefs.db*
.db-evidence/

# database backups taken by scripts/db/backup.mjs — never committed
.db-backups/

# scratch capture/probe scripts written beside the repo while measuring a
# surface. They belong in the session scratchpad; three of them reached a
# commit before this rule existed.
*.tmp.mjs
.tmp-panel/
scripts/design/r*.txt
_*.mjs
m-tmp.mjs
scripts/design/_*.mjs
chip-probe*.mjs
