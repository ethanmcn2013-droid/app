        "note_task_send_outbox_approved_hash_ck": {
          "name": "note_task_send_outbox_approved_hash_ck",
          "value": "length(\"note_task_send_outbox\".\"approved_body_sha256\") = 64 AND \"note_task_send_outbox\".\"approved_body_sha256\" NOT GLOB '*[^0-9a-f]*'"
        },
        "note_task_send_outbox_version_ck": {
          "name": "note_task_send_outbox_version_ck",
          "value": "\"note_task_send_outbox\".\"reserved_updated_at\" > \"note_task_send_outbox\".\"base_updated_at\""
        },
        "note_task_send_outbox_lifecycle_ck": {
          "name": "note_task_send_outbox_lifecycle_ck",
          "value": "(\n          \"note_task_send_outbox\".\"status\" = 'pending'\n          AND \"note_task_send_outbox\".\"task_id\" IS NULL\n          AND \"note_task_send_outbox\".\"completed_at\" IS NULL\n          AND (\n            (\"note_task_send_outbox\".\"lease_token\" IS NULL AND \"note_task_send_outbox\".\"lease_expires_at\" IS NULL)\n            OR\n            (\"note_task_send_outbox\".\"lease_token\" IS NOT NULL AND \"note_task_send_outbox\".\"lease_expires_at\" IS NOT NULL)\n          )\n        ) OR (\n          \"note_task_send_outbox\".\"status\" = 'completed'\n          AND \"note_task_send_outbox\".\"task_id\" IS NOT NULL\n          AND \"note_task_send_outbox\".\"completed_at\" IS NOT NULL\n          AND \"note_task_send_outbox\".\"lease_token\" IS NULL\n          AND \"note_task_send_outbox\".\"lease_expires_at\" IS NULL\n        )"
        },
        "note_task_send_outbox_attempt_count_ck": {
          "name": "note_task_send_outbox_attempt_count_ck",
          "value": "\"note_task_send_outbox\".\"attempt_count\" >= 1"
        }
