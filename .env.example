# Required only for a real production boot. Keep secrets in the local
# environment or deployment provider; never commit populated values.
TASKS_DATABASE_URL=
TASKS_AUTH_TOKEN=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional content-free Ping diagnostics; both remain off until admitted.
# Public values require a new client build. This does not enable Ping itself.
# See docs/PING_TELEMETRY.md for bounds, operating proof and rollback.
PING_TELEMETRY_ENABLED=0
NEXT_PUBLIC_PING_TELEMETRY_ENABLED=0
NEXT_PUBLIC_PING_TELEMETRY_DEPLOYMENT=unknown
NEXT_PUBLIC_PING_TELEMETRY_RELEASE=

# Optional private Ping cohort credential; never enables legacy Tasks/Notes AI.
# Keep generic ANTHROPIC_API_KEY unset for a Ping-only cohort. No fallback.
PING_ASSISTANT_ANTHROPIC_API_KEY=
