{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Edit(drizzle/**)",
      "Write(drizzle/**)",
      "Edit(src/server/db/schema.ts)",
      "Edit(docs/ops/migration-candidates/**)",
      "Write(docs/ops/migration-candidates/**)",
