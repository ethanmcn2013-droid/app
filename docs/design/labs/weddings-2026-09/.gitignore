# The lab carries its own Playwright so the elevate gates resolve it; the
# browser lives in the shared ms-playwright cache. The lockfile is committed,
# the install is not.
node_modules/

# The immutable Phase 1 "before" lives in shots-reference/ and is committed once.
# Every later round re-shoots into shots/, which travels in the Elevation Log
# as packed frames rather than as 8MB of PNG per round in this repository.
shots/

# Audit runs are scratch; the record is panel.json.
panel/audit-*.json
panel/audit-*.err

# Generated every round from master.html + panel.json + shots/; published as artifacts, not stored here.
frames.json
console.html
report.html

# verify-artifact.mjs leaves its three render checks behind.
_verify-*.png
