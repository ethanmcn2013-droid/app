# The wrapped copies exist only so a local browser can open a file that is
# page CONTENT. They are written by tools/wrap.mjs on every gate run and are
# 1 MB each; master.html is the artefact and it is committed.
_wrapped.html
_gate-*.html

# Working looks and measurements taken while building.
_look*.png
_audit.json
_gate.out
_before/
_nlab/
_scaffold/

# The repointed copies of the three labs' own gates, and their scratch config.
# tools/gates.mjs writes them fresh every run out of the labs themselves —
# committing them would be committing a second copy of somebody else's gate.
gates/

# Seat scratch — agents write probes here while driving the file.
# The PREFIX is the contract, not the extension, and both separators count:
# round 3 lost eighty scratch files to a rule that named only _zz_*.mjs,
# and round 6 left a .txt behind because the rule named only .mjs and .png.
# A seat writes whatever it needs to write.
_m.mjs
_zz-*
_zz_*
_drive*.mjs
_verify.out
_gate.out
_shots.out
_round1.json
_seat-*.mjs
panel/m*/
