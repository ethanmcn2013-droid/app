{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalstudio.ie/schemas/quality-council-product-receipt.schema.json",
  "title": "Signal Studio quality council product receipt",
  "description": "One fail-closed council receipt covering every required state and viewport for one product. The repository validator is authoritative for cross-file coverage, hashes, score arithmetic, and hard blockers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productId",
    "criticalExperienceId",
    "canonicalPath",
    "reviewedAt",
    "sourceGitCommitSha",
    "sourceTreeSha256",
    "contractHashes",
    "reviewers",
    "assessmentUnits",
    "declaredProductRawScore",
    "decision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "signal-quality-council-product-receipt/1"
    },
    "productId": {
      "enum": [
        "notes",
        "tasks",
        "timeline",
        "signal"
      ]
    },
    "criticalExperienceId": {
      "type": "string",
      "minLength": 1
    },
    "canonicalPath": {
      "type": "string",
      "pattern": "^/app/(notes|tasks|timeline|signal)$"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date"
    },
    "sourceGitCommitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sourceTreeSha256": {
      "$ref": "#/$defs/hash"
    },
    "contractHashes": {
      "$ref": "#/$defs/contractHashes"
    },
    "reviewers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/reviewer"
      }
    },
    "assessmentUnits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assessmentUnit"
      }
    },
    "declaredProductRawScore": {
      "type": "integer",
      "minimum": 50,
      "maximum": 52
    },
    "decision": {
      "const": "pass"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^experience/council-evidence/"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "contractHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualityCouncilGateSha256",
        "crossSuiteJourneySha256",
        "browserContractSha256",
        "registrySha256",
        "fixtureManifestSha256",
        "playwrightConfigSha256",
        "playwrightSpecSha256",
        "validatorSha256",
        "productReceiptSchemaSha256",
        "journeyReceiptSchemaSha256"
      ],
      "properties": {
        "qualityCouncilGateSha256": {
          "$ref": "#/$defs/hash"
        },
        "crossSuiteJourneySha256": {
          "$ref": "#/$defs/hash"
        },
        "browserContractSha256": {
          "$ref": "#/$defs/hash"
        },
        "registrySha256": {
          "$ref": "#/$defs/hash"
        },
        "fixtureManifestSha256": {
          "$ref": "#/$defs/hash"
        },
        "playwrightConfigSha256": {
          "$ref": "#/$defs/hash"
        },
        "playwrightSpecSha256": {
          "$ref": "#/$defs/hash"
        },
        "validatorSha256": {
          "$ref": "#/$defs/hash"
        },
        "productReceiptSchemaSha256": {
          "$ref": "#/$defs/hash"
        },
        "journeyReceiptSchemaSha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "lens",
        "kind",
        "independentReview"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "lens": {
          "type": "string",
          "minLength": 2
        },
        "kind": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "independentReview": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderedScreenshot",
        "approvedBaseline",
        "candidateScreenshot",
        "visualDiff",
        "accessibilityReport",
        "runtimeLog",
        "routeAssertions",
        "keyboardTrace",
        "reducedMotionTrace",
        "responsiveTrace",
        "performanceReport",
        "sourceReview"
      ],
      "properties": {
        "renderedScreenshot": {
          "$ref": "#/$defs/artifact"
        },
        "approvedBaseline": {
          "$ref": "#/$defs/artifact"
        },
        "candidateScreenshot": {
          "$ref": "#/$defs/artifact"
        },
        "visualDiff": {
          "$ref": "#/$defs/artifact"
        },
        "accessibilityReport": {
          "$ref": "#/$defs/artifact"
        },
        "runtimeLog": {
          "$ref": "#/$defs/artifact"
        },
        "routeAssertions": {
          "$ref": "#/$defs/artifact"
        },
        "keyboardTrace": {
          "$ref": "#/$defs/artifact"
        },
        "reducedMotionTrace": {
          "$ref": "#/$defs/artifact"
        },
        "responsiveTrace": {
          "$ref": "#/$defs/artifact"
        },
        "performanceReport": {
          "$ref": "#/$defs/artifact"
        },
        "sourceReview": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineStatus",
        "visualDiffPixelRatio",
        "axeSeriousViolations",
        "axeCriticalViolations",
        "uncaughtPageErrors",
        "consoleErrors",
        "failedRequests",
        "unexpectedHttpErrors",
        "documentOverflow",
        "keyboardOnly",
        "reducedMotion",
        "minimumPrimaryTouchTargetCssPixels",
        "performanceBudget",
        "releaseBlockingFindings",
        "highSeverityFindings",
        "canonicalRouteAndContext"
      ],
      "properties": {
        "baselineStatus": {
          "const": "approved"
        },
        "visualDiffPixelRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.0025
        },
        "axeSeriousViolations": {
          "const": 0
        },
        "axeCriticalViolations": {
          "const": 0
        },
        "uncaughtPageErrors": {
          "const": 0
        },
        "consoleErrors": {
          "const": 0
        },
        "failedRequests": {
          "const": 0
        },
        "unexpectedHttpErrors": {
          "const": 0
        },
        "documentOverflow": {
          "const": false
        },
        "keyboardOnly": {
          "const": "pass"
        },
        "reducedMotion": {
          "const": "pass"
        },
        "minimumPrimaryTouchTargetCssPixels": {
          "type": "number",
          "minimum": 44
        },
        "performanceBudget": {
          "const": "pass"
        },
        "releaseBlockingFindings": {
          "const": 0
        },
        "highSeverityFindings": {
          "const": 0
        },
        "canonicalRouteAndContext": {
          "const": "pass"
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "score",
        "reviewerId",
        "rationale",
        "positiveEvidence",
        "evidenceKeys"
      ],
      "properties": {
        "id": {
          "enum": [
            "purpose-and-task-clarity",
            "information-architecture",
            "visual-hierarchy",
            "typography-and-content",
            "layout-and-composition",
            "interaction-quality",
            "state-completeness",
            "accessibility",
            "responsive-adaptability",
            "performance-and-perceived-speed",
            "design-system-coherence",
            "brand-distinction-and-craft",
            "implementation-fidelity"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 3,
          "maximum": 4
        },
        "reviewerId": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        },
        "positiveEvidence": {
          "type": "string",
          "minLength": 20
        },
        "evidenceKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "renderedScreenshot",
              "approvedBaseline",
              "candidateScreenshot",
              "visualDiff",
              "accessibilityReport",
              "runtimeLog",
              "routeAssertions",
              "keyboardTrace",
              "reducedMotionTrace",
              "responsiveTrace",
              "performanceReport",
              "sourceReview"
            ]
          }
        }
      }
    },
    "assessmentUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "viewport",
        "evidence",
        "metrics",
        "dimensions",
        "rawScore",
        "decision"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "viewport": {
          "enum": [
            "mobile",
            "tablet",
            "desktop",
            "wide"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "dimensions": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": {
            "$ref": "#/$defs/dimension"
          }
        },
        "rawScore": {
          "type": "integer",
          "minimum": 50,
          "maximum": 52
        },
        "decision": {
          "const": "pass"
        }
      }
    }
  }
}
